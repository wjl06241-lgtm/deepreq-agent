# Independent admin only. Do not copy bot/model credentials here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# App used for the overview/users/conversation list; enterprise management is global admin.
ADMIN_APP_ID=cli_REPLACE_ME
ADMIN_ONLY_HOST=127.0.0.1
ADMIN_ONLY_PORT=3900
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=12
# Optional: only set after local worker and cloud admin use the SAME shared files.
# ADMIN_SHARED_MATERIALS_DIR=/mnt/assistant-materials
# Local worker counterpart: PROJECT_MATERIALS_DIR=...
