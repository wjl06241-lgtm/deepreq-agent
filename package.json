{
  "name": "req-assistant",
  "version": "2.1.3",
  "description": "需求助手：独立服务，飞书机器人长连接 + DeepSeek API（deepseek-v4-pro max）+ 记录/监控/运营看板",
  "type": "module",
  "main": "src/server.js",
