    "start": "node scripts/start.mjs",
    "start:single": "node src/server.js",
    "start:admin": "node src/admin-standalone.js",
    "admin:password:standalone": "node scripts/set-admin-only-password.mjs",
    "test:admin-standalone": "node tests/admin-standalone.mjs",
    "test:admin-deploy": "node tests/admin-deploy.mjs",
    "test": "node tests/configuration-import.mjs && node tests/smoke.mjs && node tests/multi-app.mjs && node tests/enterprise-switch.mjs && node tests/project-routing.mjs && node tests/codex.mjs && node tests/identity.mjs && node tests/presentation.mjs && node tests/admin.mjs && node tests/admin-standalone.mjs && node tests/registration.mjs && node tests/state-retry.mjs && node tests/codex-path.mjs",
    "chat": "node scripts/console-chat.mjs",
    "codex:check": "node scripts/codex-check.mjs",
