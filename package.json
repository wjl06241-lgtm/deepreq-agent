    "@napi-rs/canvas": "^1.0.8",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.7.3",
    "mammoth": "^1.12.2",
    "marked": "^18.0.12",
    "pg": "^8.23.0",
    "unpdf": "^1.8.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
