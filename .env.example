# 复制为 .env 并填写（启动时自动加载；同名环境变量优先于 .env）

# ── 飞书（飞书开放平台 → 自建应用 → 凭证与基础信息）────────────
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── DeepSeek API ─────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# 推理强度：min/low/medium/high/max；留空则不传该参数
REASONING_EFFORT=max
MAX_TOKENS=8000

# ── 视觉模型（可选：填 VISION_MODEL 即启用图片识别；不填则图片仅落盘）──
# 接口走 OpenAI 兼容格式，兼容 qwen-vl / glm-4v / gpt-4o / deepseek-vl 等任何兼容网关
VISION_MODEL=
# 默认复用上面的 DEEPSEEK_BASE_URL / DEEPSEEK_API_KEY；用别的视觉网关时单独填
VISION_BASE_URL=
VISION_API_KEY=
# 识别提示词（默认：描述图片并尽量完整转录其中文字）
VISION_PROMPT=
# 图片大小上限（字节，默认 10MB）
VISION_MAX_BYTES=

# ── 服务 ─────────────────────────────────────────────────────
# 运营看板端口（http://<ADMIN_HOST>:<port>/）
ADMIN_PORT=3800
# 监听地址：默认 127.0.0.1（仅本机）；部署到公网服务器、需远程访问看板时改 0.0.0.0
ADMIN_HOST=127.0.0.1
# 看板访问令牌：ADMIN_HOST 放开到 0.0.0.0 时务必设置，访问看板用 http://host:port/?token=<此值>
ADMIN_TOKEN=
# 用户消息超过该秒数无回复 → 判为未回答
UNANSWERED_TIMEOUT_SEC=600
# 未回答/异常告警推送目标（飞书私聊 open_id，多个用逗号分隔，如 feishu:ou_xxx）
ALERT_CHATS=
# 数据目录（记录/项目/会话记忆）
DATA_DIR=./data
